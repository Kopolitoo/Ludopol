<Window x:Class="Ludopol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ludopol"
        Title="Ludopol"
        Width="1600" Height="1000"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="{DynamicResource BaseFontSize}">
    <!--
      The only window, full screen or not (setting FullScreen, see ApplyWindowMode), laid out in columns so that the content gets the whole
      height of the screen:
        - left: navigation, one button under the other ("Back", "Home"… "Settings" and
          "Quit" at the bottom);
        - next to it: the page's own buttons when it has some (the filters of a list: SideHost);
        - middle: the page title on one line, then the page (PageHost). A page that scrolls
          has its "Up" / "Down" buttons on the right edge (Ui/ScrollPanel.cs).
      QuitPanel covers everything when "Quit" is chosen, to confirm.
    -->
    <Grid>
        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="{DynamicResource SideColumnWidth}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:TileButton x:Name="BackButton" Content="{local:Tr common.back}" Click="OnBackClick" />
                <local:TileButton x:Name="HomeButton" Grid.Row="1" Content="{local:Tr common.home}" Click="OnHomeClick" />
                <local:TileButton x:Name="SettingsButton" Grid.Row="3" Content="{local:Tr settings.title}" Click="OnSettingsClick" />
                <local:TileButton Grid.Row="4" Content="{local:Tr common.quit}" Click="OnQuitClick" />
            </Grid>

            <ContentControl x:Name="SideHost" Grid.Column="1" Focusable="False" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Margin="12,6,12,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <!-- The page's own buttons beside its title (the sort of a list). -->
                    <ContentControl x:Name="TitleExtras" Grid.Column="1" Focusable="False" />
                </Grid>
                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Grid>

        <Grid x:Name="QuitPanel" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{local:Tr quit.question}" FontSize="{DynamicResource TitleFontSize}"
                           HorizontalAlignment="Center" Margin="0,0,0,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <local:TileButton Content="{local:Tr quit.confirm}" Width="{DynamicResource WideButtonWidth}"
                                      Click="OnQuitConfirmClick" />
                    <local:TileButton Content="{local:Tr quit.cancel}" Width="{DynamicResource WideButtonWidth}"
                                      Click="OnQuitCancelClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
