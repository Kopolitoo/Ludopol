<Window x:Class="Ludopol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ludopol"
        Title="Ludopol"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="{DynamicResource BaseFontSize}">
    <!--
      The only window, full screen. At the top: "Back" (always top left), the page title,
      "Quit" (top right). Below: the current page (PageHost).
      QuitPanel covers everything when "Quit" is chosen, to confirm.
    -->
    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <local:TileButton x:Name="BackButton" Content="{local:Tr common.back}"
                              Width="{DynamicResource WideButtonWidth}" Click="OnBackClick" />
            <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Margin="24,0"
                       FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <local:TileButton Grid.Column="2" Content="{local:Tr common.quit}" Click="OnQuitClick" />

            <ContentControl x:Name="PageHost" Grid.Row="1" Grid.ColumnSpan="3" Focusable="False" />
        </Grid>

        <Grid x:Name="QuitPanel" Visibility="Collapsed" Background="#E61E1E24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{local:Tr quit.question}" FontSize="{DynamicResource TitleFontSize}"
                           HorizontalAlignment="Center" Margin="0,0,0,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <local:TileButton Content="{local:Tr quit.confirm}" Width="{DynamicResource WideButtonWidth}"
                                      Click="OnQuitConfirmClick" />
                    <local:TileButton Content="{local:Tr quit.cancel}" Width="{DynamicResource WideButtonWidth}"
                                      Click="OnQuitCancelClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
