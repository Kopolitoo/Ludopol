<!--
  The look of Ludopol: colours and styles shared by every page.

  Sizes (TileWidth, ButtonMinSize, BaseFontSize…) are not written here: they come from
  settings.json and are put in the resources at startup (AppSettings.ApplyTo), hence
  {DynamicResource …}.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Ludopol"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!--
      Colours: dark theme by default, strong contrast. The theme chosen in the settings
      (dark, light or as Windows) replaces them at startup and when it changes
      (Ui/ThemeColors.cs), hence {DynamicResource …} for every brush.
    -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E24" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2E2E38" />
    <SolidColorBrush x:Key="PressedBrush" Color="#45455A" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#3A3A4A" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F4F4" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B4B4BE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FD0" />
    <!-- Frame of the button under the cursor: where the gaze is. -->
    <SolidColorBrush x:Key="HoverBrush" Color="#FFD54A" />
    <!-- Behind a menu or a question that covers the page. -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#F21E1E24" />
    <!-- Empty segments of the compatibility gauge. -->
    <SolidColorBrush x:Key="GaugeEmptyBrush" Color="#45454F" />

    <!-- Default values, replaced at startup by those of settings.json. -->
    <system:Double x:Key="TileWidth">320</system:Double>
    <system:Double x:Key="TileHeight">300</system:Double>
    <system:Double x:Key="ButtonMinSize">150</system:Double>
    <system:Double x:Key="WideButtonWidth">300</system:Double>
    <system:Double x:Key="SmallButtonSize">75</system:Double>
    <system:Double x:Key="TextFieldWidth">900</system:Double>
    <system:Double x:Key="SideButtonWidth">210</system:Double>
    <system:Double x:Key="TileImageHeight">180</system:Double>
    <system:Double x:Key="BaseFontSize">28</system:Double>
    <system:Double x:Key="SmallFontSize">21</system:Double>
    <system:Double x:Key="TitleFontSize">40</system:Double>
    <Thickness x:Key="HalfSpacing">12</Thickness>

    <!--
      The big button (Ui/TileButton.cs). Under the cursor: thick yellow frame.
      Selected (IsSelected, for example the current rating): blue background.
      Disabled: faded.
      With hover activation: a yellow gauge fills at the bottom while the cursor stays on it.
    -->
    <Style TargetType="{x:Type local:TileButton}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
        <Setter Property="MinWidth" Value="{DynamicResource ButtonMinSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource ButtonMinSize}" />
        <Setter Property="Margin" Value="{DynamicResource HalfSpacing}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TileButton}">
                    <Border x:Name="Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="6"
                            CornerRadius="14">
                        <Grid>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.Resources>
                                    <!-- A text label wraps on several lines, centred: never cut.
                                         This only reaches the labels given as plain text (Content="…").
                                         A TextBlock written in a page's XAML must set
                                         TextWrapping="Wrap" itself. -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <!-- Hover activation gauge: fills from left to right during the delay. -->
                            <Rectangle Height="10" VerticalAlignment="Bottom" Fill="{DynamicResource HoverBrush}"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding HoverProgress, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text fields (my notes): ordinary Windows fields, usable with Prunel's keyboard and Dragon. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
        <Setter Property="Margin" Value="{DynamicResource HalfSpacing}" />
    </Style>

    <!-- Section titles inside a page. -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="12,24,12,0" />
    </Style>

</ResourceDictionary>
