<UserControl x:Class="Ludopol.GameDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ludopol">
    <!--
      A game's page. Left: image, then "Play" / "Install with Steam" / "Choose the program"
      (built in code: Actions). Right: the information, then what I can change
      (compatibility, tried, rating, to publish, my notes). Everything scrolls together.
      PlayPanel covers the page to confirm "Play", so that a glance does not start a game.
    -->
    <Grid>
        <local:ScrollPanel x:Name="Scroll">
            <Grid Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Width="{DynamicResource TileWidth}" Margin="12" VerticalAlignment="Top">
                    <Grid Height="{DynamicResource TileHeight}" ClipToBounds="True">
                        <Border Background="{StaticResource PlaceholderBrush}" CornerRadius="10">
                            <TextBlock x:Name="InitialsText" FontSize="{DynamicResource TitleFontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image x:Name="GameImage" Stretch="Uniform" />
                    </Grid>
                    <StackPanel x:Name="Actions" Margin="0,12,0,0" />
                </StackPanel>

                <StackPanel x:Name="Info" Grid.Column="1" />
            </Grid>
        </local:ScrollPanel>

        <Grid x:Name="PlayPanel" Visibility="Collapsed" Background="#E61E1E24">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="PlayQuestion" FontSize="{DynamicResource TitleFontSize}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="12,0,12,24" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <local:TileButton Content="{local:Tr play.confirm}" Width="{DynamicResource WideButtonWidth}"
                                      Click="OnPlayConfirmClick" />
                    <local:TileButton Content="{local:Tr play.cancel}" Width="{DynamicResource WideButtonWidth}"
                                      Click="OnPlayCancelClick" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- The menus of compatibility and rating (Ui/ChoiceMenu.cs). -->
        <local:ChoiceMenu x:Name="ChoiceMenu" />
    </Grid>
</UserControl>
