<UserControl x:Class="Ludopol.GameDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ludopol">
    <!--
      A game's page. Left: image and "Play". Right: the information, then what I can change
      (compatibility, tried, rating, to publish, my notes). Everything scrolls together.
    -->
    <local:ScrollPanel x:Name="Scroll">
        <Grid Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Width="{DynamicResource TileWidth}" Margin="12" VerticalAlignment="Top">
                <Grid Height="{DynamicResource TileHeight}" ClipToBounds="True">
                    <Border Background="{StaticResource PlaceholderBrush}" CornerRadius="10">
                        <TextBlock x:Name="InitialsText" FontSize="{DynamicResource TitleFontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image x:Name="GameImage" Stretch="Uniform" />
                </Grid>
                <!-- Launching games comes at step 4: the button is shown but disabled. -->
                <local:TileButton x:Name="PlayButton" Content="{local:Tr details.play}" IsEnabled="False"
                                  Margin="0,24,0,0" FontSize="{DynamicResource TitleFontSize}" />
            </StackPanel>

            <StackPanel x:Name="Info" Grid.Column="1" />
        </Grid>
    </local:ScrollPanel>
</UserControl>
