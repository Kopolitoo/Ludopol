<UserControl x:Class="Ludopol.ChoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ludopol">
    <!-- A grid of names (categories, tags or developers) with their number of games. -->
    <local:ScrollPanel x:Name="Scroll">
        <ItemsControl x:Name="Items">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:TileButton Width="{DynamicResource TileWidth}" Click="OnItemClick">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CountText}" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="{DynamicResource SmallFontSize}" Margin="0,6,0,0" />
                        </StackPanel>
                    </local:TileButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </local:ScrollPanel>
</UserControl>
