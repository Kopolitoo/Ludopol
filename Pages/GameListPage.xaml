<UserControl x:Class="Ludopol.GameListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ludopol">
    <!--
      A list of games: a row of filters at the top, then the game tiles (image, name,
      compatibility gauge), which scroll.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel x:Name="Filters">
            <WrapPanel.Resources>
                <Style TargetType="{x:Type local:TileButton}" BasedOn="{StaticResource {x:Type local:TileButton}}">
                    <Setter Property="Width" Value="{DynamicResource WideButtonWidth}" />
                    <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
                </Style>
            </WrapPanel.Resources>
            <local:TileButton x:Name="InstalledFilter" Click="OnInstalledFilterClick" />
            <local:TileButton x:Name="TriedFilter" Click="OnTriedFilterClick" />
            <local:TileButton x:Name="CompatibilityFilter" Click="OnCompatibilityFilterClick" />
            <local:TileButton x:Name="RatingFilter" Click="OnRatingFilterClick" />
        </WrapPanel>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="{local:Tr list.empty}" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}" />

        <local:ScrollPanel x:Name="Scroll" Grid.Row="1">
            <ItemsControl x:Name="Games">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:TileButton Width="{DynamicResource TileWidth}" Height="{DynamicResource TileHeight}"
                                          Padding="10" Click="OnGameClick"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Grid ClipToBounds="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Letters on a plain background, hidden by the image when there is one. -->
                                <Border Background="{StaticResource PlaceholderBrush}" CornerRadius="8">
                                    <TextBlock Text="{Binding Initials}" FontSize="{DynamicResource TitleFontSize}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding ImageUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="0,8,0,6"
                                           FontSize="{DynamicResource SmallFontSize}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <local:CompatibilityBar Grid.Row="2" Level="{Binding Compatibility}" Height="16" />
                            </Grid>
                        </local:TileButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </local:ScrollPanel>
    </Grid>
</UserControl>
