<UserControl x:Class="Ludopol.GameListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ludopol">
    <!--
      A list of games: the game tiles (image, name, compatibility gauge), which scroll.
      The filter buttons are in a column on the left, made in code (SideContent).
      On the search page (Home → Search), SearchBar is shown above the tiles.
      ChoiceMenu covers the list while the choices of the category or compatibility filter are shown.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ShowIfTrue" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search by title (only on the search page): an ordinary field, for Prunel's keyboard or Dragon. -->
        <DockPanel x:Name="SearchBar" Visibility="Collapsed">
            <local:TileButton DockPanel.Dock="Right" Content="{local:Tr search.clear}" Width="{DynamicResource WideButtonWidth}"
                              Click="OnClearSearchClick" />
            <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" />
        </DockPanel>

        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyText" Text="{local:Tr list.empty}" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />

            <local:ScrollPanel x:Name="Scroll">
                <ItemsControl x:Name="Games">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:TileGrid ItemMinWidth="{DynamicResource TileSlotWidth}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:TileButton Padding="10" Click="OnGameClick"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                                <StackPanel>
                                    <Grid Height="{DynamicResource TileImageHeight}" ClipToBounds="True">
                                        <!-- Letters on a plain background, hidden by the image when there is one. -->
                                        <Border Background="{DynamicResource PlaceholderBrush}" CornerRadius="8">
                                            <TextBlock Text="{Binding Initials}" FontSize="{DynamicResource TitleFontSize}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding ImageUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill" />
                                        <!-- Owned on Steam: a green tick at the top right. -->
                                        <Border Visibility="{Binding OwnedOnSteam, Converter={StaticResource ShowIfTrue}}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                Width="40" Height="40" CornerRadius="20" Background="#3BB54A">
                                            <TextBlock Text="✔" Foreground="White" FontWeight="Bold" FontSize="24"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Not owned: its price at the bottom right. -->
                                        <Border Visibility="{Binding HasShownPrice, Converter={StaticResource ShowIfTrue}}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                Padding="8,2,8,2" CornerRadius="6" Background="#D0000000">
                                            <TextBlock Text="{Binding ShownPrice}" Foreground="White"
                                                       FontSize="{DynamicResource SmallFontSize}" />
                                        </Border>
                                    </Grid>
                                    <!-- The name wraps on several lines: never cut. -->
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,6" FontSize="{DynamicResource SmallFontSize}" />
                                    <local:CompatibilityBar Level="{Binding Compatibility}" Height="16" />
                                </StackPanel>
                            </local:TileButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </local:ScrollPanel>
        </Grid>

        <!-- The menu of a filter with many values (category, compatibility), over the list. -->
        <local:ChoiceMenu x:Name="ChoiceMenu" Grid.RowSpan="2" />
    </Grid>
</UserControl>
